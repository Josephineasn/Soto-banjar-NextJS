generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("CUSTOMER")
  createdAt DateTime @default(now())
}

model Menu {
  id            Int         @id @default(autoincrement())
  name          String
  category      String
  price         Int
  description   String
  image         String
  spices        String?
  available     Boolean     @default(true)
  rating        Float       @default(5.0)
  popular       Boolean     @default(false)
  packagingInfo String      @default("Kemasan thermal pouch tahan panas")

  calories      String      @default("350 kkal")
  spicyLevel    String      @default("Tidak Pedas")

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt
  orderItems    OrderItem[]
  reviews       Review[]
}

model Order {
  id               String      @id @default(cuid())
  customerName     String
  customerPhone    String?
  area             String
  address          String
  addressBenchmark String?     @default("-")
  orderNotes       String?     @default("-")
  service          String      @default("Kurir Instant")
  shippingFee      Int         @default(0)
  serviceFee       Int         @default(0)
  voucher          String?
  discount         Int         @default(0)
  totalPrice       Int
  paymentMethod    String
  vaNumber         String?
  status           String      @default("PENDING")
  createdAt        DateTime    @default(now())
  items            OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  menuId    Int?
  name      String
  price     Int
  qty       Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu      Menu?    @relation(fields: [menuId], references: [id], onDelete: SetNull)
}

model Review {
  id        String   @id @default(cuid())
  name      String
  city      String   @default("Jakarta")
  rating    Int      @default(5)
  comment   String
  reply     String?
  createdAt DateTime @default(now())

  // Relasi ke Menu
  menuId    Int?
  menu      Menu?    @relation(fields: [menuId], references: [id], onDelete: Cascade)
}

model DeliveryArea {
  id        Int      @id @default(autoincrement())
  name      String
  price     Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ShippingService {
  id         Int      @id @default(autoincrement())
  name       String
  extraPrice Int
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model LoginHistory {
  id        Int      @id @default(autoincrement())
  logCode   String   @default("LOG-0000")
  username  String
  role      String   @default("Customer")
  status    String   @default("Berhasil")
  device    String   @default("127.0.0.1 (Web Local)")
  createdAt DateTime @default(now())
}